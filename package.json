{
  "name": "byoag-agent-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generic local connector for BYOAg-enabled platforms.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "byoag-connector": "./dist/src/index.js",
    "byoag-secret": "./dist/src/secret-cli.js"
  },
  "scripts": {
