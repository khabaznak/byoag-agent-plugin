{
  "$schema": "./schemas/plugin-extension.schema.json",
  "specVersion": "0.1.0",
  "mode": "bootstrap",
  "connectorMcpServer": "byoag",
  "discovery": {
    "wellKnownPath": "/.well-known/byoag.json",
    "httpsRequired": true,
    "loopbackHttpAllowed": false
  },
  "security": {
    "profile": "byoag-dpop+jws-0.1",
    "pairwiseIdentity": true,
    "modelIsolatedSecrets": false,
    "declarativeRemoteSkills": true,
    "nonInterference": true,
    "signedDiscovery": true,
    "proofOfPossession": "DPoP"
  },
  "schemas": {
    "discovery": "./schemas/discovery.schema.json",
    "jwks": "./schemas/jwks.schema.json",
    "pairing": "./schemas/pairing.schema.json",
    "engagement": "./schemas/engagement.schema.json",
    "delegation": "./schemas/delegation.schema.json",
    "permission": "./schemas/permission.schema.json",
    "capability": "./schemas/capability.schema.json",
    "skillBundle": "./schemas/skill-bundle.schema.json"
  }
}
