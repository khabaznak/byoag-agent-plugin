{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byoag.ai/schemas/0.1.0/jwks.schema.json",
  "title": "BYOAg JSON Web Key Set",
  "type": "object",
  "required": ["keys"],
  "properties": {
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kty", "crv", "x", "kid", "use", "alg"],
        "properties": {
          "kty": { "const": "OKP" },
          "crv": { "const": "Ed25519" },
          "x": { "type": "string", "minLength": 1 },
          "kid": { "type": "string", "minLength": 1 },
          "use": { "const": "sig" },
          "alg": { "const": "EdDSA" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
