{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byoag.ai/schemas/0.1.0/skill-bundle.schema.json",
  "title": "BYOAg Declarative Skill Bundle",
  "type": "object",
  "required": [
    "id",
    "version",
    "issuer",
    "roles",
    "requires",
    "content",
    "digest",
    "signature"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/namespaced" },
    "version": { "$ref": "#/$defs/semver" },
    "issuer": { "$ref": "#/$defs/httpsUri" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requires": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityRequirement" }
    },
    "optional": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityRequirement" }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "mediaType", "uri", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "mediaType": {
            "enum": [
              "text/markdown",
              "application/json",
              "application/schema+json",
              "text/plain"
            ]
          },
          "uri": { "$ref": "#/$defs/httpsUri" },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[A-Fa-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "required": ["alg", "kid", "value"],
      "properties": {
        "alg": { "type": "string", "minLength": 1 },
        "kid": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "namespaced": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?:https://|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?(?:/|$))"
    },
    "capabilityRequirement": {
      "type": "object",
      "required": ["capability", "versionRange"],
      "properties": {
        "capability": { "$ref": "#/$defs/namespaced" },
        "versionRange": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
